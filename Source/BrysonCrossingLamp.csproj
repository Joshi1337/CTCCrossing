  <Reference Include="System.IO.Compression"><HintPath>$(GameManaged)\System.IO.Compression.dll</HintPath><Private>false</Private></Reference><Reference Include="System.Net.Http"><HintPath>$(GameManaged)\System.Net.Http.dll</HintPath><Private>false</Private></Reference><Reference Include="mscorlib"><HintPath>$(GameManaged)\mscorlib.dll</HintPath><Private>false</Private></Reference><Reference Include="System"><HintPath>$(GameManaged)\System.dll</HintPath><Private>false</Private></Reference><Reference Include="System.Core"><HintPath>$(GameManaged)\System.Core.dll</HintPath><Private>false</Private></Reference><Reference Include="netstandard"><HintPath>$(GameManaged)\netstandard.dll</HintPath><Private>false</Private></Reference></ItemGroup>
